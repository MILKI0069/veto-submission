# Copy to your shell environment or your host's settings (Veto reads process.env; it does not load .env files itself).
# Never commit real keys. Everything below is optional: with nothing set, Veto runs fully rule-based and offline.
PORT=8787

# --- Police dashboard (/police) ---
# On the server machine itself the dashboard is open. When hosted, officers sign in with this access code
# (8 characters or more). Leave empty to keep the dashboard closed to everyone but localhost.
VETO_CONSOLE_TOKEN=
# Where the case file, pictures and the sign-off log are kept (default: ./var)
# VETO_VAR=/data/veto
# Shared hourly budget for X-rays started from the public resident page (default 240)
# VETO_XRAY_HOURLY=240

# --- Search, ads and Maps sweeps (one key is enough) ---
# SERPER_API_KEY=        # Serper.dev: Google results and Maps listings
# SERPER_BUDGET=300      # most Serper calls in one run
# BRAVE_API_KEY=         # Brave Search: web results
# GOOGLE_PLACES_KEY=     # Google Places (New): Maps listings
# SERPAPI_KEY=           # SerpApi: Google results including paid ads, and Maps listings
# SERPAPI_BUDGET=100     # most SerpApi calls in one run

# --- Optional AI second opinion (can add a warning, never remove one) ---
ANTHROPIC_API_KEY=
# VETO_AI_MODEL=claude-opus-5-5
# GROQ_API_KEY=

# --- Optional reputation look-ups ---
# ABUSECH_KEY=           # URLhaus and MalwareBazaar
# IPQS_KEY=              # phone reputation

# --- Optional database copy of the case file (for hosts whose disk is wiped on restart; set all three) ---
# VETO_STORE_URL=        # e.g. https://abcd.supabase.co  (run db/store.sql there once)
# VETO_STORE_KEY=        # the project's publishable key
# VETO_STORE_SECRET=     # your store secret; the database keeps only its SHA-256

# --- Engine and demo ---
# VETO_SHORT_LINK_FLOOR=0.3   # score given offline to a short link that cannot be expanded (0.5 reports it as phishing)
# VETO_DEMO=0                 # switch off the built-in demo scam pages on *.localhost (also switches off training cases)
# XRAY_CHANNEL=               # force a browser for the X-ray chamber: msedge | chrome | (empty = bundled chromium)

# SEARCHAPI_KEY=          # SearchApi.io search, sponsored results and Maps
